# Vortex Agent environment

# Vortex Core base URL (ws/wss). /ws/agent is appended if missing.
VORTEX_CORE_URL=wss://core.example.com

# Agent credentials from Core POST /api/v1/hosts/{id}/agents
VORTEX_AGENT_ID=11111111-1111-1111-1111-111111111111
VORTEX_SECRET_TOKEN=change-me

# Log level: debug | info | warn | error
VORTEX_LOG_LEVEL=info

# Optional tuning
VORTEX_DIAL_TIMEOUT_SEC=15
VORTEX_HEARTBEAT_INTERVAL_SEC=30
VORTEX_TELEMETRY_INTERVAL=5
VORTEX_TASK_TIMEOUT_SEC=300
VORTEX_SSH_ADDR=127.0.0.1:22
VORTEX_MAX_SESSIONS=32
